<!-- Gift Details PDP -->

<section class="pdp section" aria-labelledby="gift-pdp-title" data-pdp data-pdp-id="signature-celebration-gift-box" data-pdp-href="/gift-details?id=signature-celebration-gift-box" data-pdp-title="Signature Celebration Gift Box" data-pdp-price="48" data-pdp-image="/assets/images/gift-detail.png" data-pdp-meta="Mostly Dark · 12 pieces">
  <nav class="pdp-breadcrumb label" aria-label="Breadcrumb">
    <a href="/gifts">Gifts</a>
    <span aria-hidden="true">/</span>
    <a href="/gifts">Gift Boxes</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Signature Celebration Gift Box</span>
  </nav>

  <div class="pdp-layout">
    <div class="pdp-gallery">
      <div class="pdp-gallery__main alton-editable alton-editable--media" data-alton-editable>
        <div class="alton-editable__fallback">
          <img src="/assets/images/gift-detail.png" alt="Signature Celebration Gift Box" data-pdp-main-image loading="eager">
        </div>
        <div class="alton-editable__cms">
          <squarespace:block-field id="giftPdpMainImage" columns="12" label="EDIT: Gift detail main image (Image Block)" />
        </div>
      </div>
      <div class="pdp-gallery__thumbs" role="list">
        <button type="button" class="pdp-gallery__thumb is-active" data-pdp-thumb="/assets/images/gift-detail.png" aria-label="View main image">
          <img src="/assets/images/gift-detail.png" alt="">
        </button>
        <button type="button" class="pdp-gallery__thumb" data-pdp-thumb="/assets/images/cart-gift-box.png" aria-label="View gift box">
          <img src="/assets/images/cart-gift-box.png" alt="">
        </button>
        <button type="button" class="pdp-gallery__thumb" data-pdp-thumb="/assets/images/gift-coll-1.png" aria-label="View collection image">
          <img src="/assets/images/gift-coll-1.png" alt="">
        </button>
        <button type="button" class="pdp-gallery__thumb" data-pdp-thumb="/assets/images/product-bonbon.png" aria-label="View bonbon image">
          <img src="/assets/images/product-bonbon.png" alt="">
        </button>
      </div>
    </div>

    <div class="pdp-info">
      <div class="alton-editable" data-alton-editable>
        <div class="alton-editable__fallback">
          <p class="label pdp-info__category">Gift Boxes</p>
          <h1 id="gift-pdp-title" class="heading-md">Signature Celebration Gift Box</h1>
          <div class="product-card__rating pdp-info__rating" aria-label="Rated 4.5 out of 5">
            <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
            <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
            <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
            <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
            <img src="/assets/icons/star-half.svg" alt="" width="24" height="24">
            <span class="product-card__count">(45)</span>
          </div>
          <p class="product-card__price pdp-info__price">$48</p>
          <p class="body-lg pdp-info__desc">Twelve handcrafted pieces in a ready-to-gift box — mostly dark chocolates chosen for celebrations, thank-yous, and everyday indulgence.</p>
        </div>
        <div class="alton-editable__cms">
          <squarespace:block-field id="giftPdpInfoEdit" columns="12" label="EDIT: Gift category, title, rating, price &amp; description" />
        </div>
      </div>

      <fieldset class="pdp-options">
        <legend class="label">Choose your box size</legend>
        <div class="pdp-options__list pdp-options__list--radio" role="radiogroup" aria-label="Box size" data-gift-size>
          <label class="pdp-options__option">
            <input type="radio" name="box_size" value="6 Pieces" data-pdp-price="28">
            6 Pieces — $28.00
          </label>
          <label class="pdp-options__option is-selected">
            <input type="radio" name="box_size" value="12 Pieces" checked data-pdp-price="48">
            12 Pieces — $48.00
          </label>
          <label class="pdp-options__option">
            <input type="radio" name="box_size" value="24 Pieces" data-pdp-price="82">
            24 Pieces — $82.00
          </label>
        </div>
      </fieldset>

      <fieldset class="pdp-options">
        <legend class="label">Chocolate preference</legend>
        <div class="pdp-options__list pdp-options__list--radio" role="radiogroup" aria-label="Chocolate preference">
          <label class="pdp-options__option">
            <input type="radio" name="box_pref" value="Assorted" data-pdp-type>
            Assorted
          </label>
          <label class="pdp-options__option is-selected">
            <input type="radio" name="box_pref" value="Mostly Dark" checked data-pdp-type>
            Mostly Dark
          </label>
          <label class="pdp-options__option">
            <input type="radio" name="box_pref" value="Mostly Milk" data-pdp-type>
            Mostly Milk
          </label>
        </div>
      </fieldset>

      <div class="pdp-actions">
        <div class="qty-control" data-qty data-qty-min="1" data-pdp-qty>
          <button type="button" data-qty-minus aria-label="Decrease"><img src="/assets/icons/minus.svg" alt="" width="16" height="16"></button>
          <span class="qty-control__value" data-qty-value>1</span>
          <button type="button" data-qty-plus aria-label="Increase"><img src="/assets/icons/plus.svg" alt="" width="16" height="16"></button>
        </div>
        <button type="button" class="btn btn--terracotta" data-pdp-add-cart>Add to Cart</button>
        <a class="btn btn--outline" href="/build-box" data-pdp-build-box>Customize This Box</a>
      </div>
    </div>
  </div>

  <div class="pdp-details">
    <div class="alton-editable" data-alton-editable>
      <div class="alton-editable__fallback">
        <h2 class="pdp-details__heading">Description</h2>
        <div class="pdp-details__columns">
          <article class="pdp-details__col">
            <h3 class="label">Box contents</h3>
            <ul class="pdp-plain-list">
              <li>3x Salted caramel bonbons</li>
              <li>2x Chocolate pistachio barks</li>
              <li>2x Chocolate and sea salt caramel bars</li>
              <li>2x Sea salt caramels</li>
              <li>1x Scone toffee</li>
              <li>2x Chocolate and hazelnut cookies</li>
            </ul>
          </article>
          <article class="pdp-details__col">
            <h3 class="label">Allergens</h3>
            <p class="body-lg">May contain milk, eggs, wheat, soy, peanuts, tree nuts, and sesame. Products are prepared in a facility that handles these allergens, so cross-contact may occur.</p>
          </article>
          <article class="pdp-details__col">
            <h3 class="label">Gift Information</h3>
            <p class="body-lg">Each gift box is carefully hand-packed and presented in elegant, gift-ready packaging. Add a complimentary personal message at checkout.</p>
          </article>
        </div>
        <div class="pdp-details__shipping">
          <h3 class="label">Shipping and storage</h3>
          <p class="body-lg">Gift boxes are carefully packed to preserve freshness and presentation. Orders typically ship within 1–2 business days. Store in a cool, dry place between 60–68°F (16–20°C), away from sunlight, heat, moisture, and strong odors.</p>
        </div>
      </div>
      <div class="alton-editable__cms">
        <squarespace:block-field id="giftPdpDetailsEdit" columns="12" label="EDIT: Gift description, box contents, allergens, gift info &amp; shipping" />
      </div>
    </div>
  </div>
</section>

