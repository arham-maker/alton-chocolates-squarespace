<!-- Contact page — Figma Get In Touch section -->

<section class="contact-page-hero section" aria-labelledby="contact-page-heading">
  <div class="section-header">
    <div class="alton-editable alton-editable--center" data-alton-editable>
      <div class="alton-editable__fallback">
        <p class="label">Get in touch</p>
        <h1 id="contact-page-heading" class="heading-lg">Contact Us</h1>
        <p class="body-lg" style="max-width: 560px; margin: 16px auto 0;">
          Questions about orders, gifts, or custom boxes? Send a message and we will get back to you.
        </p>
      </div>
      <div class="alton-editable__cms">
        <squarespace:block-field id="contactHeroEdit" columns="12" label="EDIT: Contact page heading &amp; intro text" />
      </div>
    </div>
  </div>
</section>

{@|apply contact-section.block}
{@|apply newsletter.block}

<div class="alton-cms-panel">
  <div class="alton-editable" data-alton-editable>
    <div class="alton-editable__cms">
      <squarespace:block-field id="contactExtraContent" columns="12" label="EDIT: Extra Contact content (map, hours, Text / Button blocks)" />
    </div>
  </div>
</div>
