<!-- Sign In — full-bleed auth card (no page chrome) -->

<section class="auth-page" aria-labelledby="signin-heading" data-auth-page="signin">
  <div class="auth-card">
    <div class="auth-form">
      <div class="alton-editable" data-alton-editable>
        <div class="alton-editable__fallback">
          <a class="auth-form__logo" href="/" aria-label="Alton Chocolates home">
            <img src="/assets/icons/logo.svg" alt="Alton Chocolates" width="155" height="47">
          </a>
          <h1 id="signin-heading" class="heading-md auth-form__heading">Your Sweetest Moments Await.</h1>
          <p class="body-lg auth-form__copy">Sign in to continue shopping, track orders, and revisit your favorite treats.</p>
        </div>
        <div class="alton-editable__cms">
          <squarespace:block-field id="signinIntroEdit" columns="12" label="EDIT: Sign In logo, heading &amp; copy" />
        </div>
      </div>

      <form class="auth-form__fields" data-auth-form="signin" novalidate>
        <div class="auth-field">
          <label for="signin-email">Email</label>
          <div class="auth-field__input">
            <img src="/assets/icons/mail-auth.svg" alt="" width="18" height="18">
            <input id="signin-email" name="email" type="email" autocomplete="email" placeholder="Email Address" required>
          </div>
        </div>
        <div class="auth-field">
          <label for="signin-password">Password</label>
          <div class="auth-field__input">
            <img src="/assets/icons/lock-auth.svg" alt="" width="18" height="18">
            <input id="signin-password" name="password" type="password" autocomplete="current-password" placeholder="Password" required minlength="6">
          </div>
        </div>
        <button type="submit" class="btn btn--olive auth-form__submit">Sign In</button>
        <p class="form-status" data-form-status hidden role="status" aria-live="polite"></p>
      </form>

      <div class="auth-divider"><span>OR</span></div>

      <a class="auth-google" href="#" data-auth-google>
        <img src="/assets/icons/google.svg" alt="" width="20" height="20">
        Continue with Google
      </a>
      <p class="auth-google-note label">Demo only — Google sign-in is not connected.</p>

      <p class="auth-switch body-lg">
        New here?
        <a href="/sign-up">Create an Account</a>
      </p>

      <div class="alton-cms-panel alton-cms-panel--tight">
        <squarespace:block-field id="signinExtraEdit" columns="12" label="EDIT: Extra Sign In content (optional)" />
      </div>
    </div>

    <div class="auth-media">
      <div class="alton-editable alton-editable--media" data-alton-editable>
        <div class="alton-editable__fallback">
          <img src="/assets/images/auth/signin-hero.png" alt="Alton chocolate assortment" loading="eager">
        </div>
        <div class="alton-editable__cms">
          <squarespace:block-field id="signinHeroImage" columns="12" label="EDIT: Sign In hero image (Image Block)" />
        </div>
      </div>
      <div class="auth-media__quote">
        <div class="alton-editable" data-alton-editable>
          <div class="alton-editable__fallback">
            <p class="quote-text">“Thoughtful packaging and flavors that feel truly handcrafted.”</p>
            <p class="label">— Alton guests</p>
          </div>
          <div class="alton-editable__cms">
            <squarespace:block-field id="signinQuoteEdit" columns="12" label="EDIT: Sign In quote bar" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
