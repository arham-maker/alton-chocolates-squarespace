<!-- Homepage — Alton Chocolates (Figma 505:3) -->

<section class="home-hero" aria-labelledby="home-hero-heading">
  <div class="home-hero__media" aria-hidden="true">
    <img src="/assets/images/hero-home.png" alt="">
    <div class="home-hero__overlay"></div>
  </div>
  <div class="home-hero__content fade-up">
    <div class="alton-editable" data-alton-editable>
      <div class="alton-editable__fallback">
        <div>
          <p class="label">Sample text goes here</p>
          <h1 id="home-hero-heading" class="heading-xl">Chocolate,<br>Composed.</h1>
        </div>
        <p class="body-lg">Lorem ipsum dolor sit amet consectetur. Feugiat non vitae neque nisl.</p>
        <div>
          <a class="btn btn--terracotta" href="/shop">
            Shop Bonbons
            <img src="/assets/icons/arrow-right.svg" alt="" width="24" height="24">
          </a>
        </div>
      </div>
      <div class="alton-editable__cms">
        <squarespace:block-field id="homeHeroEdit" columns="12" label="EDIT: Home hero — label, heading, text &amp; button" />
      </div>
    </div>
  </div>
</section>

<div class="alton-cms-panel alton-cms-panel--tight">
  <div class="alton-editable" data-alton-editable>
    <div class="alton-editable__cms">
      <squarespace:block-field id="homeHeroImage" columns="12" label="EDIT: Optional hero image (Image Block)" />
    </div>
  </div>
</div>

<section class="section" aria-label="Shop by category">
  <div class="category-grid">
    <a class="category-card" href="/shop?category=bonbons">
      <div class="category-card__image"><img src="/assets/images/cat-bonbons.png" alt="Bonbons" width="150" height="150" loading="lazy"></div>
      <span class="category-card__label">Bonbon</span>
    </a>
    <a class="category-card" href="/shop?category=bars">
      <div class="category-card__image"><img src="/assets/images/cat-bars.png" alt="Bars" width="150" height="150" loading="lazy"></div>
      <span class="category-card__label">Bars</span>
    </a>
    <a class="category-card" href="/shop?category=bark">
      <div class="category-card__image"><img src="/assets/images/cat-bark.png" alt="Bark" width="150" height="150" loading="lazy"></div>
      <span class="category-card__label">Bark</span>
    </a>
    <a class="category-card" href="/shop?category=caramels">
      <div class="category-card__image"><img src="/assets/images/cat-caramels.png" alt="Caramels" width="150" height="150" loading="lazy"></div>
      <span class="category-card__label">Caramels</span>
    </a>
    <a class="category-card" href="/shop?category=toffee">
      <div class="category-card__image"><img src="/assets/images/cat-toffee.png" alt="Toffee" width="150" height="150" loading="lazy"></div>
      <span class="category-card__label">Toffee</span>
    </a>
    <a class="category-card" href="/shop?category=cookies">
      <div class="category-card__image"><img src="/assets/images/cat-cookies.png" alt="Cookies" width="150" height="150" loading="lazy"></div>
      <span class="category-card__label">Cookies</span>
    </a>
  </div>
  <div class="container" style="padding-bottom: 20px;">
    <squarespace:block-field id="homeCategoriesOverride" columns="12" label="Categories Collection / Summary (optional)" />
  </div>
</section>

<section class="home-bestsellers" aria-labelledby="bestsellers-heading">
  <div class="section-header section-header--row">
    <div class="section-header__center">
      <div class="alton-editable alton-editable--center" data-alton-editable>
        <div class="alton-editable__fallback">
          <p class="label">Sample text goes here</p>
          <h2 id="bestsellers-heading" class="heading-lg">Bestsellers</h2>
        </div>
        <div class="alton-editable__cms">
          <squarespace:block-field id="homeBestsellersHeading" columns="12" label="EDIT: Bestsellers heading &amp; label" />
        </div>
      </div>
    </div>
    <div class="alton-editable" data-alton-editable>
      <div class="alton-editable__fallback">
        <a class="btn btn--text" href="/shop">
          Shop All
          <img src="/assets/icons/arrow-right-dark.svg" alt="" width="24" height="24">
        </a>
      </div>
      <div class="alton-editable__cms">
        <squarespace:block-field id="homeBestsellersCta" columns="12" label="EDIT: Bestsellers button (Button Block)" />
      </div>
    </div>
  </div>

  <div class="product-grid">
    <article class="product-card" data-orderable data-shop-product data-title="Bonbon Collection" data-price="28">
      <div class="product-card__image"><img src="/assets/images/product-bonbon.png" alt="Bonbon Collection" loading="lazy"></div>
      <div class="product-card__meta">
        <h3 class="product-title">Bonbon Collection</h3>
        <p class="product-card__price">$28</p>
        <div class="product-card__rating" aria-label="Rated 4.5 out of 5">
          <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
          <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
          <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
          <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
          <img src="/assets/icons/star-half.svg" alt="" width="24" height="24">
          <span class="product-card__count">(45)</span>
        </div>
        <button type="button" class="btn btn--terracotta product-card__order" data-shop-order>Order Now</button>
      </div>
    </article>
    <article class="product-card" data-orderable data-shop-product data-title="Chocolate Bar" data-price="12">
      <div class="product-card__image"><img src="/assets/images/product-bar.png" alt="Chocolate Bar" loading="lazy"></div>
      <div class="product-card__meta">
        <h3 class="product-title">Chocolate Bar</h3>
        <p class="product-card__price">$12</p>
        <div class="product-card__rating" aria-label="Rated 4.5 out of 5">
          <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
          <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
          <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
          <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
          <img src="/assets/icons/star-half.svg" alt="" width="24" height="24">
          <span class="product-card__count">(57)</span>
        </div>
        <button type="button" class="btn btn--terracotta product-card__order" data-shop-order>Order Now</button>
      </div>
    </article>
    <article class="product-card" data-orderable data-shop-product data-title="Sea Salt Caramels" data-price="16">
      <div class="product-card__image"><img src="/assets/images/product-caramels.png" alt="Sea Salt Caramels" loading="lazy"></div>
      <div class="product-card__meta">
        <h3 class="product-title">Sea Salt Caramels</h3>
        <p class="product-card__price">$16</p>
        <div class="product-card__rating" aria-label="Rated 4.5 out of 5">
          <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
          <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
          <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
          <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
          <img src="/assets/icons/star-half.svg" alt="" width="24" height="24">
          <span class="product-card__count">(36)</span>
        </div>
        <button type="button" class="btn btn--terracotta product-card__order" data-shop-order>Order Now</button>
      </div>
    </article>
    <article class="product-card" data-orderable data-shop-product data-title="Chocolate Cookies" data-price="14">
      <div class="product-card__image"><img src="/assets/images/product-cookies.png" alt="Chocolate Cookies" loading="lazy"></div>
      <div class="product-card__meta">
        <h3 class="product-title">Chocolate Cookies</h3>
        <p class="product-card__price">$14</p>
        <div class="product-card__rating" aria-label="Rated 4.5 out of 5">
          <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
          <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
          <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
          <img src="/assets/icons/star-filled.svg" alt="" width="24" height="24">
          <img src="/assets/icons/star-half.svg" alt="" width="24" height="24">
          <span class="product-card__count">(25)</span>
        </div>
        <button type="button" class="btn btn--terracotta product-card__order" data-shop-order>Order Now</button>
      </div>
    </article>
  </div>

  <div style="margin-top: 30px;">
    <squarespace:block-field id="homeBestsellers" columns="12" label="Bestsellers Summary / Products Block" />
  </div>
</section>

<section class="split-section" aria-labelledby="home-build-heading">
  <div class="split-section__media">
    <img src="/assets/images/build-box-cta.png" alt="Assorted chocolate box" loading="lazy">
  </div>
  <div class="split-section__content split-section__content--blush">
    <div>
      <p class="label">Sample text goes here</p>
      <h2 id="home-build-heading" class="heading-lg">Build Your Box</h2>
    </div>
    <p class="body-lg">Lorem ipsum dolor sit amet consectetur. Feugiat non vitae neque nisl.</p>
    <a class="btn btn--terracotta" href="/build-box">
      Start Building
      <img src="/assets/icons/arrow-right.svg" alt="" width="24" height="24">
    </a>
    <squarespace:block-field id="homeBuildBox" columns="12" label="Build Box Section (editable)" />
  </div>
</section>

<section class="banner-section" aria-labelledby="sweeter-heading">
  <div class="banner-section__bg">
    <img src="/assets/images/banner-sweeter.png" alt="" loading="lazy">
  </div>
  <div class="banner-section__overlay"></div>
  <div class="banner-section__content">
    <div>
      <p class="label">Sample text goes here</p>
      <h2 id="sweeter-heading" class="heading-lg">A Sweeter<br>Tomorrow</h2>
    </div>
    <p class="body-lg">Lorem ipsum dolor sit amet consectetur.</p>
    <a class="btn btn--olive" href="/our-story">
      Our Story
      <img src="/assets/icons/arrow-right.svg" alt="" width="24" height="24">
    </a>
    <squarespace:block-field id="homeBanner" columns="12" label="Banner Content Override" />
  </div>
  <div class="banner-section__side" aria-hidden="true">
    <span>Sample text goes here</span>
    <span>Sample text goes here</span>
    <span>Sample text goes here</span>
  </div>
</section>

<section class="split-section" aria-labelledby="details-heading">
  <div class="split-section__media">
    <img src="/assets/images/details-craft.png" alt="Hand decorating a bonbon" loading="lazy">
  </div>
  <div class="split-section__content split-section__content--cream">
    <div>
      <p class="label">Sample text goes here</p>
      <h2 id="details-heading" class="heading-lg">Details Make<br>A Sweeter World</h2>
    </div>
    <div class="feature-icons">
      <div class="feature-icon">
        <img src="/assets/icons/leaf.svg" alt="" width="32" height="32">
        <span>Sample<br>Text</span>
      </div>
      <div class="feature-icon">
        <img src="/assets/icons/heart.svg" alt="" width="32" height="32">
        <span>Sample<br>Text</span>
      </div>
      <div class="feature-icon">
        <img src="/assets/icons/plant.svg" alt="" width="32" height="32">
        <span>Sample<br>Text</span>
      </div>
    </div>
    <a class="btn btn--text" href="/gifts">
      Gift Someone
      <img src="/assets/icons/arrow-right-dark.svg" alt="" width="24" height="24">
    </a>
    <squarespace:block-field id="homeDetails" columns="12" label="Details Section Editable Content" />
  </div>
</section>

{@|apply contact-section.block}

