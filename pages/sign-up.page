<!-- Sign Up — full-bleed auth card (no page chrome) -->

<section class="auth-page" aria-labelledby="signup-heading" data-auth-page="signup">
  <div class="auth-card">
    <div class="auth-form">
      <div class="alton-editable" data-alton-editable>
        <div class="alton-editable__fallback">
          <a class="auth-form__logo" href="/" aria-label="Alton Chocolates home">
            <img src="/assets/icons/logo.svg" alt="Alton Chocolates" width="155" height="47">
          </a>
          <h1 id="signup-heading" class="heading-md auth-form__heading">A Sweeter Experience Starts Here.</h1>
          <p class="body-lg auth-form__copy">Create an account to save favorites, track orders, and unlock member moments.</p>
        </div>
        <div class="alton-editable__cms">
          <squarespace:block-field id="signupIntroEdit" columns="12" label="EDIT: Sign Up logo, heading &amp; copy" />
        </div>
      </div>

      <form class="auth-form__fields" data-auth-form="signup" novalidate>
        <div class="auth-field">
          <label for="signup-name">Full Name</label>
          <div class="auth-field__input">
            <img src="/assets/icons/person.svg" alt="" width="18" height="18">
            <input id="signup-name" name="name" type="text" autocomplete="name" placeholder="Full Name" required>
          </div>
        </div>
        <div class="auth-field">
          <label for="signup-email">Email</label>
          <div class="auth-field__input">
            <img src="/assets/icons/mail-auth.svg" alt="" width="18" height="18">
            <input id="signup-email" name="email" type="email" autocomplete="email" placeholder="Email Address" required>
          </div>
        </div>
        <div class="auth-field">
          <label for="signup-password">Password</label>
          <div class="auth-field__input">
            <img src="/assets/icons/lock-auth.svg" alt="" width="18" height="18">
            <input id="signup-password" name="password" type="password" autocomplete="new-password" placeholder="Password" required minlength="6">
          </div>
        </div>
        <button type="submit" class="btn btn--olive auth-form__submit">Create Account</button>
        <p class="form-status" data-form-status hidden role="status" aria-live="polite"></p>
      </form>

      <div class="auth-divider"><span>OR</span></div>

      <a class="auth-google" href="#" data-auth-google>
        <img src="/assets/icons/google.svg" alt="" width="20" height="20">
        Continue with Google
      </a>
      <p class="auth-google-note label">Demo only — Google sign-in is not connected.</p>

      <p class="auth-switch body-lg">
        Already have an account?
        <a href="/sign-in">Sign In</a>
      </p>

      <div class="alton-cms-panel alton-cms-panel--tight">
        <squarespace:block-field id="signupExtraEdit" columns="12" label="EDIT: Extra Sign Up content (optional)" />
      </div>
    </div>

    <div class="auth-media">
      <div class="alton-editable alton-editable--media" data-alton-editable>
        <div class="alton-editable__fallback">
          <img src="/assets/images/auth/signup-hero.png" alt="Handcrafted Alton chocolates" loading="eager">
        </div>
        <div class="alton-editable__cms">
          <squarespace:block-field id="signupHeroImage" columns="12" label="EDIT: Sign Up hero image (Image Block)" />
        </div>
      </div>
      <div class="auth-media__quote">
        <div class="alton-editable" data-alton-editable>
          <div class="alton-editable__fallback">
            <p class="quote-text">“Every piece feels like a celebration — delicate shells, rich fillings, unforgettable moments.”</p>
            <p class="label">— Alton guests</p>
          </div>
          <div class="alton-editable__cms">
            <squarespace:block-field id="signupQuoteEdit" columns="12" label="EDIT: Sign Up quote bar" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
