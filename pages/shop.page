<section class="shop-hero" aria-labelledby="shop-hero-heading">
  <div class="shop-hero__content">
    <div class="alton-editable" data-alton-editable>
      <div class="alton-editable__fallback">
        <h1 id="shop-hero-heading" class="heading-lg">New Bonbons<br>Have Arrived</h1>
        <p class="body-lg shop-hero__desc">Our latest collection of handcrafted bonbons is here. Discover delicate shells, rich fillings, and new flavors made to be savored.</p>
      </div>
      <div class="alton-editable__cms">
        <squarespace:block-field id="shopHeroEdit" columns="12" label="EDIT: Shop hero heading &amp; description" />
      </div>
    </div>
  </div>
  <div class="shop-hero__media alton-editable alton-editable--media" data-alton-editable>
    <div class="alton-editable__fallback">
      <img src="/assets/images/shop-hero.png" alt="Gift box of assorted bonbons" loading="eager">
    </div>
    <div class="alton-editable__cms">
      <squarespace:block-field id="shopHeroImage" columns="12" label="EDIT: Shop hero image (Image Block)" />
    </div>
  </div>
</section>

<section class="shop-categories" aria-labelledby="categories-heading">
