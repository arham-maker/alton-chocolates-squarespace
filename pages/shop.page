<!-- Shop page — Figma 511:2 -->

<section class="shop-hero" aria-labelledby="shop-hero-heading">
  <div class="shop-hero__content">
    <h1 id="shop-hero-heading" class="heading-lg">New Bonbons<br>Have Arrived</h1>
    <div class="body-lg">
      <squarespace:block-field id="shopHeroCopy" columns="12" label="Shop Hero Copy" />
    </div>
  </div>
  <div class="shop-hero__media">
    <img src="/assets/images/shop-hero.png" alt="Gift box of assorted bonbons" loading="eager">
  </div>
</section>

<section class="shop-categories" aria-labelledby="categories-heading">
  <div class="section-header">
    <h2 id="categories-heading" class="heading-lg">Categories</h2>
    <p class="body-lg" style="max-width: 520px; margin: 16px auto 0;">
      <squarespace:block-field id="shopCategoriesIntro" columns="12" label="Categories Intro" />
    </p>
  </div>
  <div class="category-grid">
    <a class="category-card" href="#products"><div class="category-card__image"><img src="/assets/images/cat-bonbons.png" alt="Bonbons" loading="lazy"></div><span class="category-card__label">Bonbons</span></a>
    <a class="category-card" href="#products"><div class="category-card__image"><img src="/assets/images/cat-bars.png" alt="Bars" loading="lazy"></div><span class="category-card__label">Bars</span></a>
    <a class="category-card" href="#products"><div class="category-card__image"><img src="/assets/images/cat-bark.png" alt="Bark" loading="lazy"></div><span class="category-card__label">Bark</span></a>
    <a class="category-card" href="#products"><div class="category-card__image"><img src="/assets/images/cat-caramels.png" alt="Caramels" loading="lazy"></div><span class="category-card__label">Caramels</span></a>
    <a class="category-card" href="#products"><div class="category-card__image"><img src="/assets/images/cat-toffee.png" alt="Toffee" loading="lazy"></div><span class="category-card__label">Toffee</span></a>
    <a class="category-card" href="#products"><div class="category-card__image"><img src="/assets/images/cat-cookies.png" alt="Cookies" loading="lazy"></div><span class="category-card__label">Cookies</span></a>
  </div>
</section>

