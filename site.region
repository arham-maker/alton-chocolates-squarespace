<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {squarespace-headers}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/alton.css">
    <link rel="stylesheet" href="/assets/cms-editable.css">
    <style id="alton-figma">
html,body\{margin:0!important;padding:0!important;background:#F5F2EC!important;color:#2F1A0D!important;font-family:"Poppins","Helvetica Neue",Arial,sans-serif!important\}
.alton-site a,.alton-site a:link,.alton-site a:visited\{color:inherit!important;text-decoration:none!important\}
.announcement-bar\{background:#626145!important;color:#F5F2EC!important;min-height:50px!important;display:flex!important;align-items:center!important;justify-content:center!important;position:relative!important;padding:12px 48px!important;text-align:center!important;width:100%!important\}
.announcement-bar[hidden],.announcement-bar.is-dismissed\{display:none!important\}
.announcement-bar__fallback,.announcement-bar p\{margin:0!important;font-family:"Poppins",sans-serif!important;font-weight:500!important;font-size:14px!important;line-height:22px!important;letter-spacing:.2em!important;text-transform:uppercase!important;color:#F5F2EC!important\}
.announcement-bar__close\{position:absolute!important;right:50px!important;top:50%!important;transform:translateY(-50%)!important;background:transparent!important;border:0!important;width:28px!important;height:28px!important;padding:0!important;cursor:pointer!important;display:flex!important;align-items:center!important;justify-content:center!important;z-index:5!important\}
.announcement-bar__close img\{width:20px!important;height:20px!important;display:block!important;pointer-events:none!important\}
.site-header\{background:#F5F2EC!important;padding:30px 50px 20px!important;position:relative!important;z-index:100!important;width:100%!important\}
.site-header__inner\{display:grid!important;grid-template-columns:1fr auto 1fr!important;align-items:center!important;gap:20px!important;max-width:1440px!important;margin:0 auto!important;width:100%!important\}
.site-header__search\{display:inline-flex!important;align-items:center!important;gap:10px!important;justify-self:start!important;font-family:"Poppins",sans-serif!important;font-weight:500!important;font-size:12px!important;letter-spacing:.2em!important;text-transform:uppercase!important;color:#2F1A0D!important;text-decoration:none!important;background:transparent!important;border:0!important;padding:0!important;cursor:pointer!important\}
.site-header__search img\{width:20px!important;height:20px!important\}
.alton-search[hidden]\{display:none!important\}
.alton-search\{position:fixed!important;inset:0!important;z-index:10000!important;display:flex!important;align-items:center!important;justify-content:center!important;padding:24px!important\}
.alton-search__backdrop\{position:absolute!important;inset:0!important;background:rgba(47,26,13,.45)!important\}
.alton-search__panel\{position:relative!important;z-index:1!important;width:min(720px,100%)!important;max-width:720px!important;margin:0!important;background:#F5F2EC!important;padding:40px 36px 48px!important;max-height:84vh!important;overflow:auto!important\}
.alton-search__hint\{text-align:center!important;margin:20px 0 0!important\}
.alton-search__form\{display:flex!important;gap:12px!important;align-items:stretch!important\}
.alton-search__input\{flex:1 1 auto!important;min-width:0!important;width:100%!important;box-sizing:border-box!important;background:#fff!important;border:1px solid #F0E8E0!important;padding:14px 16px!important;font-size:16px!important;color:#2F1A0D!important;font-family:"Poppins",sans-serif!important\}.alton-search__form .btn\{flex:0 0 auto!important\}
.alton-search__item\{display:flex!important;justify-content:space-between!important;gap:16px!important;padding:18px 0!important;border-bottom:1px solid #F0E8E0!important;text-decoration:none!important\}
.alton-search__item-title\{font-family:"Poppins",sans-serif!important;font-weight:600!important;font-size:14px!important;letter-spacing:.12em!important;text-transform:uppercase!important;color:#2F1A0D!important;margin:0!important\}
.site-header__brand\{display:flex!important;flex-direction:column!important;align-items:center!important;gap:10px!important;text-align:center!important\}
.site-header__logo\{display:block!important;width:155px!important;height:auto!important\}
.site-header__logo img\{width:155px!important;height:auto!important;display:block!important\}
.site-header__actions\{justify-self:end!important;display:flex!important;align-items:center!important;gap:16px!important\}
.site-header__account img\{width:20px!important;height:20px!important\}
.site-header__toggle\{display:none!important\}
.site-header__desktop-nav\{width:100%!important\}
.site-nav,.site-header__desktop-nav .site-nav,.site-header__desktop-nav nav\{display:flex!important;align-items:center!important;justify-content:center!important;gap:50px!important;flex-wrap:wrap!important;list-style:none!important;margin:0!important;padding:0!important\}
.site-nav a,.site-header__desktop-nav a\{font-family:"Poppins",sans-serif!important;font-weight:600!important;font-size:14px!important;line-height:22px!important;letter-spacing:.2em!important;text-transform:uppercase!important;color:#5D5958!important;padding:10px 0!important;border-bottom:1px solid transparent!important;text-decoration:none!important;display:inline-block!important\}
.site-nav a.is-active,.site-nav a:hover,.site-header__desktop-nav a:hover\{color:#2F1A0D!important;border-bottom-color:#2F1A0D!important;opacity:1!important\}
.mobile-nav\{display:none!important\}
.home-hero\{position:relative!important;min-height:568px!important;display:flex!important;align-items:center!important;overflow:hidden!important;width:100%!important;background:#F5F2EC!important\}
.home-hero__media\{position:absolute!important;inset:0!important\}
.home-hero__media img\{width:100%!important;height:100%!important;object-fit:cover!important;display:block!important\}
.home-hero__overlay\{position:absolute!important;inset:0!important;background:linear-gradient(89.83deg,rgba(239,232,224,.5) 21%,rgba(239,232,224,0) 72%)!important\}
.home-hero__content\{position:relative!important;z-index:1!important;max-width:725px!important;padding:60px 50px!important;display:flex!important;flex-direction:column!important;gap:28px!important\}
.label\{font-family:"Poppins",sans-serif!important;font-weight:500!important;font-size:14px!important;line-height:22px!important;letter-spacing:.2em!important;text-transform:uppercase!important;color:#5D5958!important;margin:0!important\}
.heading-xl\{font-family:"Playfair Display",Georgia,serif!important;font-weight:400!important;font-size:88px!important;line-height:1!important;letter-spacing:.01em!important;text-transform:uppercase!important;color:#2F1A0D!important;margin:0!important\}
.heading-lg\{font-family:"Playfair Display",Georgia,serif!important;font-weight:400!important;font-size:58px!important;line-height:1!important;letter-spacing:.01em!important;text-transform:uppercase!important;color:#2F1A0D!important;margin:0!important\}
.body-lg\{font-family:"Poppins",sans-serif!important;font-weight:400!important;font-size:18px!important;line-height:30px!important;color:#2F1A0D!important;margin:0!important\}
.btn\{display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:10px!important;padding:10px 50px!important;font-family:"Poppins",sans-serif!important;font-weight:600!important;font-size:14px!important;letter-spacing:.1em!important;text-transform:uppercase!important;border:0!important;cursor:pointer!important;text-decoration:none!important;white-space:nowrap!important\}
.btn img\{width:24px!important;height:24px!important\}
.btn--terracotta\{background:#A9705E!important;color:#F5F2EC!important\}
.btn--olive\{background:#626145!important;color:#F5F2EC!important\}
.btn--text\{background:transparent!important;color:#2F1A0D!important;padding:10px 0!important;border-bottom:1px solid #2F1A0D!important\}
.category-grid\{display:grid!important;grid-template-columns:repeat(6,minmax(0,1fr))!important;gap:24px!important;max-width:1240px!important;margin:0 auto!important;padding:50px 20px!important;width:100%!important;box-sizing:border-box!important\}
.category-card\{display:flex!important;flex-direction:column!important;align-items:center!important;gap:20px!important;text-align:center!important;text-decoration:none!important;background:transparent!important;border:0!important;padding:0!important;cursor:pointer!important;font:inherit!important;color:inherit!important\}.category-card.is-active .category-card__image\{box-shadow:0 0 0 6px rgba(98,97,69,.35)!important;transform:scale(1.03)!important\}
.category-card__image\{width:150px!important;height:150px!important;border-radius:50%!important;overflow:hidden!important;background:#ECD7D0!important\}
.category-card__image img\{width:100%!important;height:100%!important;object-fit:cover!important\}
.category-card__label\{font-family:"Poppins",sans-serif!important;font-weight:600!important;font-size:14px!important;letter-spacing:.2em!important;text-transform:uppercase!important;color:#5D5958!important\}
.home-bestsellers\{padding:50px 100px 70px!important\}
.section-header--row\{display:flex!important;align-items:flex-end!important;justify-content:space-between!important;position:relative!important;min-height:110px!important;margin-bottom:50px!important;text-align:left!important\}
.section-header__center\{position:absolute!important;left:50%!important;transform:translateX(-50%)!important;text-align:center!important;pointer-events:none!important;z-index:0!important\}
.section-header--row>.alton-editable:not(.alton-editable--center),.section-header--row>.btn--text\{width:auto!important;max-width:max-content!important;margin-left:auto!important;flex:0 0 auto!important;text-align:right!important;position:relative!important;z-index:1!important\}
.product-grid\{display:grid!important;grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:30px 20px!important;width:100%!important;align-items:stretch!important\}
.product-card\{display:flex!important;flex-direction:column!important;gap:14px!important;height:100%!important\}.product-card--orderable,.product-card[data-shop-product],.product-card[data-gift-card]\{cursor:pointer!important\}
.product-card__image\{aspect-ratio:1/1.05!important;overflow:hidden!important;display:block!important\}
.product-card__image img\{width:100%!important;height:100%!important;object-fit:cover!important\}
.product-title\{font-family:"Poppins",sans-serif!important;font-weight:600!important;font-size:18px!important;line-height:26px!important;letter-spacing:.2em!important;text-transform:uppercase!important;color:#2F1A0D!important;margin:0!important\}
.product-card__meta\{background:#fff!important;padding:20px!important;display:flex!important;flex-direction:column!important;align-items:stretch!important;gap:12px!important;text-align:left!important;flex:1 1 auto!important;width:100%!important;box-sizing:border-box!important\}
.product-card__meta .product-title\{min-height:52px!important;margin:0!important\}
.product-card__order\{width:100%!important;margin-top:auto!important\}
.qty-control\{display:inline-flex!important;align-items:center!important;justify-content:space-between!important;width:118px!important;box-sizing:border-box!important;border:1px solid #F0E8E0!important;padding:8px 12px!important\}
.qty-control button\{background:transparent!important;border:0!important;outline:none!important;box-shadow:none!important;width:20px!important;height:20px!important\}
.product-card__price\{font-family:"Poppins",sans-serif!important;font-weight:600!important;font-size:18px!important;color:#2F1A0D!important;margin:0!important\}
.product-card__rating\{display:flex!important;align-items:center!important;gap:5px!important\}
.product-card__rating img\{width:24px!important;height:24px!important\}
.alton-order[hidden]\{display:none!important\}
.alton-order\{position:fixed!important;inset:0!important;z-index:10900!important;display:flex!important;align-items:center!important;justify-content:center!important;padding:24px!important\}
.alton-order__backdrop\{position:absolute!important;inset:0!important;background:rgba(47,26,13,.5)!important\}
.alton-order__panel\{position:relative!important;z-index:1!important;width:min(560px,100%)!important;max-height:90vh!important;overflow:auto!important;background:#F5F2EC!important;padding:36px 32px 40px!important\}
.alton-order__form\{display:grid!important;grid-template-columns:1fr 1fr!important;gap:18px 16px!important\}
.alton-order__form .form-field--full,.alton-order__form .form-actions\{grid-column:1/-1!important\}.alton-thanks[hidden]\{display:none!important\}.alton-thanks\{position:fixed!important;inset:0!important;z-index:11000!important;display:flex!important;align-items:center!important;justify-content:center!important;padding:24px!important\}.alton-thanks__backdrop\{position:absolute!important;inset:0!important;background:rgba(47,26,13,.5)!important\}.alton-thanks__card\{position:relative!important;z-index:1!important;width:min(440px,100%)!important;background:#F5F2EC!important;padding:48px 36px 40px!important;text-align:center!important\}
.split-section\{display:grid!important;grid-template-columns:1fr 1fr!important;min-height:396px!important;width:100%!important\}
.split-section__media\{min-height:320px!important;overflow:hidden!important\}
.split-section__media img\{width:100%!important;height:100%!important;object-fit:cover!important;display:block!important;min-height:396px!important\}
.split-section__content\{display:flex!important;flex-direction:column!important;justify-content:center!important;padding:50px 74px!important;gap:28px!important\}
.split-section__content--blush\{background:#ECD7D0!important\}
.split-section__content--cream\{background:#F5F2EC!important\}
.feature-icons\{display:flex!important;align-items:flex-start!important;gap:40px!important;flex-wrap:wrap!important\}
.feature-icon\{display:flex!important;flex-direction:column!important;align-items:center!important;gap:16px!important;width:70px!important;text-align:center!important\}
.feature-icon img\{width:32px!important;height:32px!important\}
.banner-section\{position:relative!important;min-height:329px!important;display:flex!important;align-items:center!important;overflow:hidden!important;color:#F5F2EC!important;width:100%!important\}
.banner-section__bg\{position:absolute!important;inset:0!important\}
.banner-section__bg img\{width:100%!important;height:100%!important;object-fit:cover!important\}
.banner-section__overlay\{position:absolute!important;inset:0!important;background:linear-gradient(90.63deg,rgba(46,25,12,.7) 33%,rgba(46,25,12,0) 57%)!important\}
.banner-section__content\{position:relative!important;z-index:1!important;padding:50px 100px!important;max-width:640px!important;display:flex!important;flex-direction:column!important;gap:20px!important\}
.banner-section__content .label\{color:#ECD7D0!important\}
.banner-section__content .heading-lg,.banner-section__content .body-lg\{color:#F5F2EC!important\}
.banner-section__side\{display:none!important\}
.contact-section\{display:grid!important;grid-template-columns:1fr 1fr!important;gap:60px!important;padding:80px 100px!important;align-items:start!important\}
.testimonials\{padding:80px 100px!important;text-align:center!important;background:#f7f5f0!important\}
.testimonials__slider\{position:relative!important;display:grid!important;grid-template-columns:54px 1fr 54px!important;align-items:center!important;gap:16px!important;margin:40px auto 0!important;max-width:1240px!important\}
.testimonials__viewport\{overflow:hidden!important;width:100%!important\}
.testimonials__track\{display:flex!important;gap:40px!important;margin:0!important;will-change:transform!important\}
.testimonial-card\{flex:0 0 calc((100% - 80px)/3)!important;min-width:200px!important;display:flex!important;flex-direction:column!important;gap:20px!important;align-items:center!important;opacity:1!important;visibility:visible!important\}.testimonial-card__name\{font-family:\"Poppins\",sans-serif!important;font-weight:600!important;font-size:14px!important;letter-spacing:.15em!important;text-transform:uppercase!important;color:#5D5958!important;margin:0!important\}
.testimonial-card__quote\{font-family:"Playfair Display",Georgia,serif!important;font-style:italic!important;font-size:22px!important;line-height:1.5!important;color:#2F1A0D!important\}
.testimonials__nav\{width:54px!important;height:54px!important;border-radius:50%!important;border:1px solid rgba(47,26,13,.2)!important;background:rgba(255,255,255,.85)!important;display:flex!important;align-items:center!important;justify-content:center!important;cursor:pointer!important;position:static!important;transform:none!important\}
.testimonial-card__quote\{font-family:"Playfair Display",Georgia,serif!important;font-style:italic!important;font-size:22px!important;line-height:1.5!important;color:#2F1A0D!important\}
.newsletter\{padding:70px 100px!important;text-align:center!important;background:rgba(236,215,208,.35)!important\}
.site-footer\{background:#F5F2EC!important;padding:60px 100px 30px!important;border-top:1px solid #F0E8E0!important\}
.site-footer__top\{display:grid!important;grid-template-columns:1.4fr 1fr 1fr 1fr!important;gap:40px!important;margin-bottom:50px!important\}
.site-footer__bottom\{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:20px!important;padding-top:24px!important;border-top:1px solid #F0E8E0!important;flex-wrap:wrap!important\}
.site-footer__col-title\{font-family:"Poppins",sans-serif!important;font-weight:600!important;font-size:14px!important;letter-spacing:.2em!important;text-transform:uppercase!important;color:#2F1A0D!important;margin:0 0 20px!important\}
.site-footer__links\{display:flex!important;flex-direction:column!important;gap:12px!important\}
.site-footer__links a\{font-size:14px!important;color:#5D5958!important;text-decoration:none!important\}
#page,.alton-main,main#page\{max-width:none!important;width:100%!important;padding:0!important;margin:0!important\}
@media (max-width:1024px)\{.category-grid\{grid-template-columns:repeat(3,minmax(0,1fr))!important\}.product-grid\{grid-template-columns:repeat(2,minmax(0,1fr))!important\}.site-footer__top\{grid-template-columns:1fr 1fr!important\}.heading-xl\{font-size:64px!important\}.heading-lg\{font-size:46px!important\}\}
@media (max-width:900px)\{.section-header--row\{flex-direction:column!important;align-items:stretch!important\}.section-header--row .section-header__center\{position:static!important;transform:none!important\}.section-header--row>.alton-editable:not(.alton-editable--center),.section-header--row .btn--text\{align-self:flex-end!important;margin-left:auto!important;text-align:right!important\}.site-header__toggle\{display:flex!important;flex-direction:column!important;justify-content:center!important;gap:5px!important;width:40px!important;height:40px!important;background:transparent!important;border:0!important;padding:8px!important\}.site-header__toggle span\{display:block!important;width:22px!important;height:2px!important;background:#2F1A0D!important\}.site-header__desktop-nav,.site-header__account\{display:none!important\}.site-header.is-open .mobile-nav\{display:flex!important;flex-direction:column!important;gap:0!important;padding:10px 0 20px!important\}.home-hero,.split-section,.contact-section\{display:flex!important;flex-direction:column!important\}.product-grid,.site-footer__top\{grid-template-columns:1fr!important\}.heading-xl\{font-size:42px!important\}.heading-lg\{font-size:34px!important\}.home-bestsellers,.contact-section,.testimonials,.newsletter,.site-footer,.banner-section__content,.home-hero__content,.split-section__content\{padding-left:16px!important;padding-right:16px!important\}.section-header--row\{flex-direction:column!important;align-items:center!important\}.section-header__center\{position:static!important;transform:none!important\}\}
@media (max-width:640px)\{.category-grid\{grid-template-columns:repeat(2,minmax(0,1fr))!important\}.category-card__image\{width:110px!important;height:110px!important\}\}
@media (max-width:700px)\{.alton-search,.alton-order,.alton-thanks\{padding:12px!important;align-items:stretch!important\}.alton-search__panel,.alton-order__panel,.alton-thanks__card\{width:100%!important;max-width:100%!important;max-height:calc(100vh - 24px)!important;padding:24px 18px 28px!important;box-sizing:border-box!important\}.alton-search__form\{flex-direction:column!important;align-items:stretch!important;gap:12px!important\}.alton-search__input\{width:100%!important;flex:1 1 auto!important;min-width:0!important\}.alton-search__form .btn\{width:100%!important;flex:none!important;padding-left:24px!important;padding-right:24px!important\}.alton-order__form\{grid-template-columns:1fr!important\}.alton-order__form .form-actions .btn\{width:100%!important;min-width:0!important\}.alton-search__item\{flex-direction:column!important;align-items:flex-start!important;gap:6px!important\}\}
</style>
  </head>
  <body id="{squarespace.page-id}" class="{squarespace.page-classes} alton-site">
    {.section website}
      {@|apply site-header.block}
    {.end}

    <main id="page" class="alton-main" role="main" data-content-field="main-content">
      {squarespace.main-content}
    </main>

    {.section website}
      {@|apply site-footer.block}
      {@|apply site-modals.block}
    {.end}

    <script src="/scripts/site.js"></script>
    {squarespace-scripts}
  </body>
</html>
