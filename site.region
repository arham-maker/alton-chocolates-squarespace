<!doctype html>
<html lang="en">
  <head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Localized Styles -->
    {squarespace-headers}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  </head>
  <body id="{squarespace.page-id}" class="{squarespace.page-classes} alton-site">
    {.section website}
      {@|apply site-header.block}
    {.end}

    <main id="page" class="alton-main" role="main" data-content-field="main-content">
      {squarespace.main-content}
    </main>

    {.section website}
      {@|apply site-footer.block}
    {.end}

    <script src="/scripts/site.js"></script>
    {squarespace-scripts}
  </body>
</html>
