<section class="split-section" aria-labelledby="details-heading">
  <div class="split-section__media alton-editable alton-editable--media" data-alton-editable>
    <div class="alton-editable__fallback">
      <img src="/assets/images/details-craft.png" alt="Hand decorating a bonbon" loading="lazy">
    </div>
    <div class="alton-editable__cms">
      <squarespace:block-field id="detailsSectionImage" columns="12" label="EDIT: Details section image (Image Block)" />
    </div>
  </div>
  <div class="split-section__content split-section__content--cream">
    <div class="alton-editable" data-alton-editable>
      <div class="alton-editable__fallback">
        <div>
          <p class="label">Sample text goes here</p>
          <h2 id="details-heading" class="heading-lg">Details Make<br>A Sweeter World</h2>
        </div>
        <div class="feature-icons">
          <div class="feature-icon">
            <img src="/assets/icons/leaf.svg" alt="" width="32" height="32">
            <span>Sample<br>Text</span>
          </div>
          <div class="feature-icon">
            <img src="/assets/icons/heart.svg" alt="" width="32" height="32">
            <span>Sample<br>Text</span>
          </div>
          <div class="feature-icon">
            <img src="/assets/icons/plant.svg" alt="" width="32" height="32">
            <span>Sample<br>Text</span>
          </div>
        </div>
        <a class="btn btn--text" href="/gifts">
          Gift Someone
          <img src="/assets/icons/arrow-right-dark.svg" alt="" width="24" height="24">
        </a>
      </div>
      <div class="alton-editable__cms">
        <squarespace:block-field id="detailsSectionCopy" columns="12" label="EDIT: Details section — heading, icons text &amp; button" />
      </div>
    </div>
  </div>
</section>
