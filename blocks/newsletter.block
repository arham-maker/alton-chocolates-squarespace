<section class="newsletter" id="newsletter" aria-labelledby="newsletter-heading">
  <div class="newsletter__inner">
    <div class="alton-editable alton-editable--center" data-alton-editable>
      <div class="alton-editable__fallback">
        <h2 id="newsletter-heading" class="heading-lg">Stay in Touch</h2>
        <p class="label">Sample text goes here</p>
      </div>
      <div class="alton-editable__cms">
        <squarespace:block-field id="newsletterHeadingEdit" columns="12" label="EDIT: Newsletter heading &amp; text" />
      </div>
    </div>

    <div class="alton-editable alton-editable--center" data-alton-editable data-sqs-form-slot>
      <div class="alton-editable__fallback">
        <form class="newsletter-form" data-alton-form="newsletter" action="mailto:galton4@gmail.com" method="post" enctype="text/plain">
          <label for="newsletter-email" class="sr-only">Email Address</label>
          <input id="newsletter-email" name="email" type="email" placeholder="Email Address" required autocomplete="email">
          <button type="submit" class="btn btn--olive">Subscribe</button>
          <p class="form-status" data-form-status hidden role="status" aria-live="polite"></p>
        </form>
      </div>
      <div class="alton-editable__cms newsletter-form-wrap sqs-form-slot">
        <squarespace:block-field id="newsletterForm" columns="12" label="EDIT: Newsletter form — add Squarespace Newsletter/Form Block" />
      </div>
    </div>
  </div>
</section>
