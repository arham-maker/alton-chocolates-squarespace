<aside class="announcement-bar" data-announcement role="region" aria-label="Site announcement">
  <div class="announcement-bar__editable">
    <squarespace:block-field id="siteAnnouncement" columns="12" label="EDIT: Announcement bar text (Text Block)" />
  </div>
  <p class="announcement-bar__fallback">Free shipping on orders over $75/-</p>
  <button type="button" class="announcement-bar__close" data-announcement-close aria-label="Dismiss announcement">
    <img src="/assets/icons/cancel.svg" alt="" width="20" height="20">
  </button>
</aside>

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <div class="alton-editable site-header__search-wrap" data-alton-editable>
      <div class="alton-editable__fallback">
        <button type="button" class="site-header__search" data-search-open aria-label="Open search" aria-expanded="false" aria-controls="alton-search">
          <img src="/assets/icons/search.svg" alt="" width="20" height="20">
          <span>Search</span>
        </button>
      </div>
      <div class="alton-editable__cms">
        <squarespace:block-field id="headerSearchLabel" columns="12" label="EDIT: Header Search label (Text / Button)" />
      </div>
    </div>

    <div class="site-header__brand">
      <a class="site-header__logo" href="/" aria-label="{siteTitle}">
        {.section logoImage}
          <img src="{assetUrl}?format=300w" alt="{siteTitle}">
        {.or}
          <img src="/assets/icons/logo.svg" alt="{siteTitle}" width="155" height="47">
        {.end}
      </a>
      <div class="site-header__desktop-nav">
        <squarespace:navigation navigationId="mainNav" template="navigation" />
      </div>
    </div>

    <div class="site-header__actions">
      <a class="site-header__account" href="/account/login" aria-label="Account">
        <img src="/assets/icons/person.svg" alt="" width="20" height="20">
      </a>
      <button type="button" class="site-header__toggle" data-nav-toggle aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <squarespace:navigation navigationId="mainNav" template="navigation" />
  </div>
</header>

<div class="alton-search" id="alton-search" data-search-panel hidden>
  <div class="alton-search__backdrop" data-search-close tabindex="-1" aria-hidden="true"></div>
  <div class="alton-search__panel" role="dialog" aria-modal="true" aria-labelledby="alton-search-title">
    <div class="alton-search__top">
      <div class="alton-editable" data-alton-editable>
        <div class="alton-editable__fallback">
          <h2 id="alton-search-title" class="heading-lg">Search</h2>
        </div>
        <div class="alton-editable__cms">
          <squarespace:block-field id="searchModalTitle" columns="12" label="EDIT: Search modal title" />
        </div>
      </div>
      <button type="button" class="alton-search__close" data-search-close aria-label="Close search">
        <img src="/assets/icons/cancel.svg" alt="" width="20" height="20">
      </button>
    </div>

    <form class="alton-search__form" data-search-form action="/search" method="get" role="search">
      <label class="sr-only" for="alton-search-input">Search chocolates</label>
      <input
        id="alton-search-input"
        class="alton-search__input"
        data-search-input
        type="search"
        name="q"
        placeholder="Search bonbons, gifts, pages…"
        autocomplete="off"
        enterkeyhint="search"
        data-search-placeholder
      >
      <button type="submit" class="btn btn--terracotta" data-search-submit>Search</button>
    </form>

    <div class="alton-editable" data-alton-editable>
      <div class="alton-editable__fallback">
        <p class="alton-search__hint label" data-search-hint>Search you quiery with space</p>
      </div>
      <div class="alton-editable__cms">
        <squarespace:block-field id="searchModalHint" columns="12" label="EDIT: Search hint text" />
      </div>
    </div>

    <div class="alton-search__results" data-search-results aria-live="polite"></div>
    <p class="alton-search__empty body-lg" data-search-empty hidden>No matches. Browse the <a href="/shop">Shop</a> or <a href="/gifts">Gifts</a>.</p>

    <div class="alton-editable" data-alton-editable>
      <div class="alton-editable__cms">
        <squarespace:block-field id="searchModalEmpty" columns="12" label="EDIT: Optional search empty-state override" />
      </div>
    </div>

    <div class="alton-cms-panel alton-cms-panel--tight">
      <squarespace:block-field id="searchModalExtra" columns="12" label="EDIT: Extra search modal content (optional)" />
    </div>
  </div>
</div>
