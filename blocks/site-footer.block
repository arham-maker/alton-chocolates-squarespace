<footer class="site-footer" role="contentinfo">
  <div class="site-footer__top">
    <div class="site-footer__brand">
      <a href="/" class="site-footer__brand-logo-link" aria-label="{siteTitle}">
        {.section logoImage}
          <img class="site-footer__brand-logo" src="{assetUrl}?format=300w" alt="{siteTitle}">
        {.or}
          <img class="site-footer__brand-logo" src="/assets/icons/logo.svg" alt="{siteTitle}" width="180" height="54">
        {.end}
      </a>
      <p class="site-footer__brand-text">Sample text goes here</p>
    </div>

    <div>
      <h2 class="site-footer__col-title">Shop</h2>
      <nav class="site-footer__links" aria-label="Shop links">
        <a href="/shop">All Chocolates</a>
        <a href="/shop#products">Bonbons</a>
        <a href="/shop#products">Barks</a>
        <a href="/shop#products">Bars</a>
        <a href="/shop#products">Caramels</a>
        <a href="/shop#products">Toffee</a>
        <a href="/shop#products">Cookies</a>
        <squarespace:navigation navigationId="footerShop" template="footer-nav" />
      </nav>
    </div>

    <div>
      <h2 class="site-footer__col-title">Other</h2>
      <nav class="site-footer__links" aria-label="Other links">
        <a href="/our-story">Our Story</a>
        <a href="/build-box">Build a Box</a>
        <a href="/gifts">Gift</a>
        <a href="/gifts#premium-gifts-heading">Gallery</a>
        <squarespace:navigation navigationId="footerOther" template="footer-nav" />
      </nav>
    </div>

    <div>
      <h2 class="site-footer__col-title">Help</h2>
      <nav class="site-footer__links" aria-label="Help links">
        <a href="/contact">Contact Support</a>
        <a href="/#newsletter">Membership</a>
        <a href="/contact">FAQ’s</a>
        <squarespace:navigation navigationId="footerHelp" template="footer-nav" />
      </nav>
    </div>
  </div>

  <div class="site-footer__bottom">
    <p class="site-footer__copy">© 2026 Alton Chocolates. All Right Reserved</p>
    <div class="site-footer__meta">
      <div class="site-footer__social">
        <a href="https://facebook.com" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
          <img src="/assets/icons/facebook.svg" alt="" width="20" height="20">
        </a>
        <a href="https://instagram.com" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
          <img src="/assets/icons/instagram.svg" alt="" width="20" height="20">
        </a>
      </div>
      <div class="site-footer__legal">
        <a href="/contact">Privacy</a>
        <a href="/contact">Terms</a>
        <squarespace:navigation navigationId="footerLegal" template="footer-nav" />
      </div>
    </div>
  </div>
</footer>
